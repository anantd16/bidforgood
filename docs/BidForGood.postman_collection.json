{
  "info": {
    "name": "BidForGood API",
    "description": "Charity auction backend. Run requests in order: Auth -> Items -> Bids -> Auctions -> Winners. Tokens/IDs are saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "bobToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "auctionId",
      "value": ""
    },
    {
      "key": "adminId",
      "value": ""
    },
    {
      "key": "winnerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create an admin user. Returns JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin\",\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "try { pm.collectionVariables.set('adminToken', j.token); } catch(e) {}",
                  "try { pm.collectionVariables.set('adminId', j.user.id); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create a normal user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob\",\n  \"email\": \"bob@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "try { pm.collectionVariables.set('bobToken', j.token); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "try { pm.collectionVariables.set('adminToken', j.token); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "try { pm.collectionVariables.set('bobToken', j.token); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Save FCM Token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/fcm-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "fcm-token"
              ]
            },
            "description": "Registers device token for push notifications.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"device-token-here\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Create Item (+auction)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "description": "Creates an item and its auction.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Painting\",\n  \"description\": \"Charity painting\",\n  \"startingPrice\": 100,\n  \"durationMinutes\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "try { pm.collectionVariables.set('itemId', j.item._id); } catch(e) {}",
                  "try { pm.collectionVariables.set('auctionId', j.auction._id); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get Item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Painting (updated)\",\n  \"description\": \"New description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bids",
      "item": [
        {
          "name": "Place Bid (Bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bids"
              ]
            },
            "description": "Must exceed current highest bid. Broadcasts newBid via Socket.io.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"amount\": 150\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Place Lower Bid (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bids"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"amount\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Bids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bids"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get Bids For Item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bids/item/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bids",
                "item",
                "{{itemId}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Auctions",
      "item": [
        {
          "name": "Get All Auctions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auctions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auctions"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get Auction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auctions/{{auctionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auctions",
                "{{auctionId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "End Auction (admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auctions/{{auctionId}}/end",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auctions",
                "{{auctionId}}",
                "end"
              ]
            },
            "description": "Force-ends auction, creates Winner, sends push.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Winners",
      "item": [
        {
          "name": "Get All Winners + Total Funds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/winners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "winners"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "try { pm.collectionVariables.set('winnerId', j.winners[0]._id); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Winner",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/winners/{{winnerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "winners",
                "{{winnerId}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Send Notification (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "send"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{adminId}}\",\n  \"title\": \"Hello\",\n  \"body\": \"Test notification\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}